{
  "schema_version": "asl-pilot-reviewer-authority/v1",
  "status": "trusted_reviewer_key",
  "trusted_at": "YYYY-MM-DDTHH:mm:ssZ",
  "pre_review_key_binding_confirmed": true,
  "reviewer": {
    "name": "replace-with-reviewer-name",
    "role": "replace-with-deaf-educator-or-qualified-asl-instructor-role",
    "qualification": "replace-with-actual-asl-qualification",
    "affiliation_or_context": "replace-with-affiliation-or-context",
    "contact_or_signed_evidence": "replace-with-contact-or-credential-reference",
    "is_project_operator": false
  },
  "trusted_key": {
    "algorithm": "ed25519",
    "public_key_pem": "replace-with-reviewer-ed25519-public-key-pem",
    "signer_key_fingerprint_sha256": "replace-with-sha256-of-spki-public-key"
  },
  "credential_evidence": {
    "summary": "replace-with-reviewer-credential-or-context-evidence-summary",
    "files": [
      {
        "path": "data/vocabulary-review/evidence/replace-with-reviewer-credential-evidence-file",
        "sha256": "replace-with-sha256-of-evidence-file",
        "purpose": "Reviewer ASL qualification or credential evidence"
      }
    ]
  },
  "key_binding_evidence": {
    "summary": "replace-with-evidence-that-this-public-key-belongs-to-the-reviewer-summary",
    "files": [
      {
        "path": "data/vocabulary-review/evidence/replace-with-reviewer-key-binding-evidence-file",
        "sha256": "replace-with-sha256-of-evidence-file",
        "purpose": "Evidence that the Ed25519 public key belongs to this reviewer"
      }
    ]
  },
  "trusted_by": {
    "name": "replace-with-person-distinct-from-reviewer-who-checked-the-reviewer-key",
    "role": "replace-with-role",
    "contact_or_signed_evidence": "replace-with-contact-or-signature-reference-distinct-from-reviewer",
    "evidence": {
      "summary": "replace-with-operator-attestation-summary-that-reviewer-identity-and-key-binding-were-checked",
      "files": [
        {
          "path": "data/vocabulary-review/evidence/replace-with-operator-trust-attestation-file",
          "sha256": "replace-with-sha256-of-evidence-file",
          "purpose": "Operator attestation that reviewer identity and key binding were checked before review"
        }
      ]
    }
  }
}
