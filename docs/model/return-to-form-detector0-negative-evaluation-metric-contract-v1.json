  "pass_fail_gate_semantics": {
    "evaluation_can_pass_only_if": [
      "prediction artifact schema and hashes validate against this contract",
      "prediction artifact declares a scratch-trained Detector 0 with no pretrained components",
      "positive held-out hand IoU strictly beats fixed baselines for left_or_first_hand and right_or_second_hand",
      "positive recall_at_iou_0_30 >= 0.98 and recall_at_iou_0_50 >= 0.90 on expected-present learned hand targets",
      "positive false_no_hand_rate <= 0.02",
      "strict no-hand negative false_trigger_rate <= 0.05 excluding non_target_asl_sign context rows",
      "all category-level negative counts are reported",
      "claim surfaces remain fail-closed until a future promotion receipt explicitly updates them"
    ],
    "automatic_fail_conditions": [
      "missing or mutated source artifact hash",
      "any external M3IH row used as training input",
      "generated, pseudo, pretrained detector, landmark, feature, backbone, or teacher labels used as metric target authority",
      "evaluation run mixes train rows into held-out beat-it comparison without disclosure",
      "non_target_asl_sign rows counted as strict no-hand absence rows",
      "positive absent right-hand targets counted as false no-hand misses",
      "threshold profile missing or changed mid-evaluation",
      "claim surfaces edited before passing evaluation and promotion receipts exist"
