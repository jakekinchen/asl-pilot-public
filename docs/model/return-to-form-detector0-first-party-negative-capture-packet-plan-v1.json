    "future_row_may_be_authoritative_only_if": [
      "a later active prompt explicitly authorizes first-party dataset capture",
      "human approval for the bounded capture session is recorded",
      "clip-level consent evidence matches consent version and signer identity",
      "raw clip path and SHA-256 hash are recorded after approved local capture",
      "operator capture-condition evidence matches the category requirement",
      "reviewer confirms no learned hand target is visible",
      "absence label receipt is human/project reviewed and not generated",
      "pretrained detector, landmark, feature, backbone, teacher, generated, and pseudo-label evidence are absent",
      "split assignment preserves signer-disjoint policy",
      "withdrawal handling is acknowledged"
    ]
  },
  "review_and_fail_closed_rules": {
    "block_slot_if": [
      "consent evidence is missing, stale, unsigned, or mismatched",
      "signer alias or signer identity hash is missing",
