# Vercel builds only web/ (project rootDirectory = web). Exclude every other
# top-level lane so the upload stays lean — main carries the model/data/
# research repo (data/ alone is ~47GB).
artifacts/
tools/
scripts/
research/
configs/
supabase/
product/
models/
infra/
data/
output/
docs/
analysis/
tests/
notebooks/
brev/
.claude/
.codex/
# build/dep caches and VCS
**/node_modules/
**/.next/
.git/
# stray model/checkpoint/archive blobs anywhere outside web/public
/*.pt
/*.onnx
/*.zip
/*.tar
/*.mp4
