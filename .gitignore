# Round-001 task-026 Stage A / MediaPipe vestige untracking.
# These directories held the MediaPipe-bound Stage A teacher frontier
# landmark caches and Stage B supervision manifests; they are removed
# from git tracking but may remain on disk locally as historical
# evidence. Delete locally with `rm -rf artifacts/stage_a/
# artifacts/stage_b/` if storage is needed.
artifacts/stage_a/
artifacts/stage_b/

# Mission 3AK local training smoke checkpoint.
# Keep the JSON provenance tracked, but do not commit the binary checkpoint.
artifacts/rawframe-lesson-milestone/model_state.pt

# Round-001 task-027 push-blocker cleanup.
# The PrimaryMath classroom HDF5 dataset (train/val/test.hdf5) was
# removed from all history via git-filter-repo to enable GitHub push
# (each file exceeded the 100 MB hard limit). The data is part of the
# deprecated keypoint lane and is not referenced by the rawframe lane.
# Pre-rewrite history is preserved in ../asl-pilot-backup-2026-05-23.
# If the dataset is ever needed again, re-download from source rather
# than re-commit.
data/external/primarymath-classroom-asl-118/*.hdf5

# preflight run records (transient, regenerated on each run)
docs/validation/preflight-runs.log
